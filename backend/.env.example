# Port the API server listens on
PORT=8787

# Set to 'true' to use in-memory mock data (no Google credentials needed)
# Automatically falls back to mock mode if GOOGLE_SHEET_ID is not set.
USE_MOCK=true

# Google Spreadsheet ID (the long ID from the sheet URL)
GOOGLE_SHEET_ID=

# Name of the worksheet/tab inside the spreadsheet
GOOGLE_SHEET_NAME=Participants

# Google service-account credentials as a JSON string.
# Create a service account in Google Cloud Console, download the JSON key,
# then paste the entire JSON content here (escaped to a single line), e.g.:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_KEY=
