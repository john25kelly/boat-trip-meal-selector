# Frontend app name shown in docs and optional UI contexts
VITE_APP_NAME=Boat Trip Meal Selector

# Google Sheets source-of-truth configuration (sheet ID only, no credentials)
VITE_GOOGLE_SHEET_ID=1FxJSHJwhK3OBaBs2ll-2D4OJkf5aQeJCi-VSQE47O3w

# Backend base URL used by the frontend integration boundary
# Writes should go through this API and never directly from browser to Google APIs.
VITE_API_BASE_URL=http://localhost:8787/api

# Placeholder auth session storage key
VITE_AUTH_SESSION_KEY=boat-trip-meal-selector-session

# Set to false when connected to a real backend
VITE_USE_MOCK_API=true
